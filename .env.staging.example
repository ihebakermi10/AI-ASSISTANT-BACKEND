# ============================================
# STAGING ENVIRONMENT CONFIGURATION
# ============================================
# This file is for ngrok/staging deployments
# Copy to .env.staging and update with your values

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=staging

# ============================================
# DEPLOYMENT CONFIGURATION
# ============================================
# Your ngrok public URL (used for Swagger docs)
PUBLIC_URL=https://liana-uncompromising-sueann.ngrok-free.dev

# Optional: Override if different from PUBLIC_URL
API_BASE_URL=

# ============================================
# OPENAI CONFIGURATION
# ============================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-2024-05-13

# ============================================
# PINECONE CONFIGURATION
# ============================================
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX=ai-assistant-docs

# ============================================
# MONGODB CONFIGURATION (Docker)
# ============================================
MONGODB_URI=mongodb://mongodb:27017/ai-assistant

# ============================================
# VALKEY CONFIGURATION (Docker)
# ============================================
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DB=0
VALKEY_TTL=3600

# ============================================
# NGROK CONFIGURATION
# ============================================
NGROK_DOMAIN=liana-uncompromising-sueann.ngrok-free.dev
NGROK_AUTH_TOKEN=your-ngrok-auth-token-here
