{
  "name": "ai-assistant-backend",
  "version": "1.0.0",
  "description": "AI-powered backend service with OpenAI function calling, RAG (Pinecone), and MongoDB",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest",
    "test:run": "vitest run",
    "seed:db": "tsx scripts/ingestion/seed.ts",
    "seed:pinecone": "tsx scripts/ingestion/index-doc.ts",
    "seed:pinecone:all": "tsx scripts/ingestion/index-multiple-docs.ts",
    "test:connections": "tsx scripts/testing/test-connections.ts",
    "test:query": "tsx scripts/testing/test-query.ts",
    "test:rag": "tsx scripts/testing/test-rag-queries.ts",
    "check:pinecone": "tsx scripts/testing/check-pinecone.ts"
  },
  "keywords": [
    "ai",
    "openai",
    "function-calling",
    "rag",
    "pinecone",
    "mongodb",
    "koa",
    "typescript"
  ],
  "author": "Iheb",
  "license": "MIT",
  "dependencies": {
    "@koa/router": "^12.0.2",
    "@openai/agents": "^0.1.9",
    "@pinecone-database/pinecone": "^4.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "ioredis": "^5.4.2",
    "is-generator-function": "1.0.10",
    "koa": "^2.15.0",
    "koa-bodyparser": "^4.4.1",
    "koa2-swagger-ui": "^5.12.0",
    "mongoose": "^8.8.4",
    "openai": "^4.76.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "swagger-jsdoc": "^6.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa__router": "^12.0.4",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.2.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
